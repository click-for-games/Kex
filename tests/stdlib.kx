// Kex standard library tester
//
//   kex tests/stdlib.kx

let checks = 0;
let failures = 0;

fn check(label, actual, expected) {
    checks = checks + 1;
    if (actual == expected) {
        print("  ok    ", label);
    } else {
        failures = failures + 1;
        print("  FAIL  ", label, " got ", actual, " want ", expected);
    }
}

print("json");
let parsed = json_parse('{"ok":true,"items":[1,2,3],"meta":{"page":2}}');
check("json get", json_get(parsed, "items.1"), 2);
check("json set", json_get(json_set(parsed, "meta.page", 9), "meta.page"), 9);
check("json pretty", count_of(json_pretty({ "a": [1, 2] }), "\n  \"a\"") > 0, true);

print("strings");
check("title", "hello wide world".title(), "Hello Wide World");
check("slug", "Hello Wide World".slug(), "hello-wide-world");
check("trim start", "  hi  ".trim_start(), "hi  ");
check("replace all", "a-b-c".replace_all("-", "/"), "a/b/c");
check("count of", count_of("banana", "an"), 2);

print("arrays");
let xs = [3, 1, 2];
check("sort by", to_str(xs.sort_by((v) => v)), "[1, 2, 3]");
check("some", xs.some((v) => v == 2), true);
check("every", xs.every((v) => v > 0), true);
check("zip", to_str(xs.zip(["a", "b"])), "[[3, a], [1, b]]");
check("chunk", to_str(xs.chunk(2)), "[[3, 1], [2]]");
check("avg", xs.avg(), 2);

print("objects");
let obj = { "a": 1, "b": 2 };
check("entries", to_str(obj.entries()), "[[a, 1], [b, 2]]");
check("pick", to_str(obj.pick(["a"])), '{a: 1}');
check("omit", to_str(obj.omit(["a"])), '{b: 2}');
check("invert", to_str(obj.invert()), '{1: a, 2: b}');
check("deep set", json_get(deep_set({ "a": {} }, "a.b", 7), "a.b"), 7);

print("math");
check("gcd", gcd(12, 18), 6);
check("lcm", lcm(4, 6), 12);
check("factorial", factorial(5), 120);
check("round to", round_to(3.14159, 2), 3.14);
check("hypot", hypot(3, 4), 5);
check("log base", log_base(8, 2), 3);

print("time and utilities");
check("date format", date_format(0, "YYYY-MM-DD HH:mm:ss"), "1970-01-01 00:00:00");
check("base64", base64_encode("hello"), "aGVsbG8=");
check("base64 round trip", base64_decode("aGVsbG8="), "hello");
check("uuid length", len(uuid()), 36);
check("hash length", len(hash("hello")), 16);

print("files");
let temp = env_get("TEMP") == null ? "." : env_get("TEMP");
let file = path_join(temp, "kex_stdlib_test.txt");
check("write", file_write(file, "kex"), true);
check("read", file_read(file), "kex");
check("exists", file_exists(file), true);
check("meta size", file_meta(file).size, 3);
check("delete", file_delete(file), true);

print("");
print(checks - failures, "/", checks, " stdlib checks passed");
if (failures > 0) {
    error("stdlib tester failed");
}
