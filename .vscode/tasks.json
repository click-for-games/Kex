{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KEXDRUN: Execute File",
      "type": "shell",
      "command": "cargo run --quiet -- '${file}'",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}