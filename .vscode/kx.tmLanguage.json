{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kex Language",
  "patterns": [
    {
      "name": "comment.line.double-slash.kx",
      "match": "//.*$"
    },
    {
      "name": "comment.block.kx",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.single.kx",
      "begin": "'",
      "end": "'"
    },
    {
      "name": "string.quoted.double.kx",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "keyword.control.kx",
      "match": "\\b(let|if|else|while|fn|return|kxout|kxin|len|cast|syscall)\\b"
    },
    {
      "name": "constant.language.boolean.kx",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "constant.numeric.kx",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    }
  ],
  "scopeName": "source.kx"
}